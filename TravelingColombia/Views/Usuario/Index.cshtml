@model   TravelingColombia.Filtros.FiltroUsuarioCiewModel

<div class="min-h-screen bg-gradient-to-b  flex flex-col items-center p-6 space-y-6">
    <!-- Botones superiores -->
    <div
        class="flex w-full justify-between items-center bg-[#3085BC]  rounded-xl shadow-lg p-4 px-16 flex-nowrap overflow-x-auto gap-2">

        <button id="btn-Lista" onclick="mostrarApartado('Lista')" class="text-black cursor-pointer bg-[#6ca7cf]  px-2 py-1 rounded-full 
               text-sm sm:text-base md:text-lg 
               w-24 sm:w-28 md:w-32 lg:w-40 
               h-10 sm:h-12 md:h-14">
            Lista
        </button>

        <button id="btn-Crear" onclick="mostrarApartado('Crear')" class="text-black cursor-pointer bg-white font-semibold px-2 py-1 rounded-full 
               text-sm sm:text-base md:text-lg 
               w-24 sm:w-28 md:w-32 lg:w-40 
               h-10 sm:h-12 md:h-14">
            Crear
        </button>

    </div>



    <!-- Contenedor de viajes -->
    <div id="Lista" class="bg-white w-full max-w-[1700px] rounded-2xl p-8 ">
        <div
            class="relative p-10 rounded-xl bg-[url('https://img.freepik.com/foto-gratis/terminal-aeropuerto_1417-1456.jpg?semt=ais_hybrid&w=740')] bg-cover ">
            <h2
                class="relative bottom-18  text-2xl w-[900px] h-[60px] rounded-full  border left-80 bg-white font-bold text-center pt-2">
                Gestion Usuarios</h2>
            <!-- Formulario -->
            <form method="get" asp-action="Index" asp-controller="Usuario"
                class="flex flex-wrap gap-x-10 gap-y-5 w-full p-6 bg-white rounded-xl shadow-lg">

                <!-- Campos personalizados -->
                <div class="flex flex-col flex-1 min-w-[200px]">
                    <label class="mb-1 font-semibold text-gray-700">email</label>
                    <input name="EmailUsuario" type="text" class="p-2 rounded-lg border border-gray-300" />
                </div>

                <div class="flex flex-col flex-1 min-w-[200px]">
                    <label class="mb-1 font-semibold text-gray-700">Rol</label>
                    <select name="IdRol" class="p-2 rounded-lg border border-gray-300">
                        <option value="">Seleccione Rol</option>
                        @foreach(var Rol in Model.ListaRoles){
                            <option value="@Rol.IdRol">@Rol.Rol1</option>
                        }
                    </select>
                </div>

                <!-- Botón buscar -->
                <div class="flex justify-center w-full mt-4">
                    <button type="submit"
                        class="bg-[#3085BC] hover:bg-[#3084bcd2] text-white font-bold py-3 px-8 rounded-full transition duration-300">
                        Listar
                    </button>
                </div>
            </form>

            <!-- Tabla de planes -->
            <div
                class="bg-white w-full max-w-full h-[400px] p-4 mt-6 overflow-x-auto overflow-y-auto rounded-xl shadow-md">
                <table class="min-w-[700px] w-full  border-collapse table-auto">
                    <thead>
                        <tr class="bg-[#3085BC] text-white text-sm sm:text-base">
                            <th class="px-4 py-2 border">Nombre</th>
                            <th class="px-4 py-2 border">Apellido</th>
                            <th class="px-4 py-2 border">Celular</th>
                            <th class="px-4 py-2 border">Email</th>
                            <th class="px-4 py-2 border">Edad</th>
                            <th class="px-4 py-2 border">Rol</th>
                            <th class="px-4 py-2 border">Facturas</th>
                            <th class="px-4 py-2 border w-[250px]">Acciones</th>
                        </tr>

                    </thead>
                    <tbody>

                        @foreach(var Usuario in Model.listaUsuarios){
                            <tr class="hover:bg-gray-50">
                            <td class="px-4 py-2 border">@Usuario.NombreUsuario</td>
                            <td class="px-4 py-2 border">@Usuario.ApellidoUsuario</td>
                            <td class="px-4 py-2 border">@Usuario.CelularUsuario</td>
                            <td class="px-4 py-2 border">@Usuario.EmailUsuario</td>
                            <td class="px-4 py-2 border">@Usuario.EdadUsuario</td>
                            <td class="px-4 py-2 border">@Usuario.Rol</td>
                            <td class="px-4 py-2 border">@Usuario.CantidadFacturas</td>
                            <td class="px-4 py-2 border">
                                <div class="flex justify-between ">
                                    <a asp-action="Editar" asp-controller="Usuario" asp-route-id="@Usuario.IdUsuario"
                                        class="btn bg-white hover:bg-yellow-600">Editar</a>
                                    <a asp-action="Eliminar" asp-controller="Usuario" asp-route-id="@Usuario.IdUsuario"
                                        class="btn bg-white hover:bg-red-600">Eliminar</a>
                                </div>
                            </td>

                        </tr>


                        }
                        
                    </tbody>
                </table>
            </div>

        </div>
    </div>

    <!-- contenedor formulario viajes-->
    <div id="Crear" class="max-w-4xl mx-auto mt-10 bg-white p-8 rounded-lg shadow-lg hidden">
        <h2 class="text-2xl font-bold mb-6 text-center text-[#3085BC]">Registrar Usuario</h2>

        <form method="post" asp-action="Crear" asp-controller="Usuario" >

            <!-- Nombre -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                <label class="block text-sm font-medium text-gray-700">Nombre</label>
                <input name="NombreUsuario" type="text" placeholder="Carlos"
                    class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring focus:border-blue-300" />
            </div>

            <!-- Apellido -->
            <div>
                <label class="block text-sm font-medium text-gray-700">Apellido</label>
                <input name="ApellidoUsuario" type="text" placeholder="Pérez"
                    class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring focus:border-blue-300" />
            </div>

            <!-- Celular -->
            <div>
                <label class="block text-sm font-medium text-gray-700">Celular</label>
                <input name="CelularUsuario" type="text" placeholder="3001234567"
                    class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring focus:border-blue-300" />
            </div>

            <!-- Email -->
            <div>
                <label class="block text-sm font-medium text-gray-700">Email</label>
                <input name="EmailUsuario" type="email" placeholder="correo@ejemplo.com"
                    class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring focus:border-blue-300" />
            </div>

            <!-- Edad -->
            <div>
                <label class="block text-sm font-medium text-gray-700">Edad</label>
                <input name="EdadUsuario" type="number" placeholder="30"
                    class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring focus:border-blue-300" />
            </div>

            <!-- Rol -->
            <div>
                <label class="block text-sm font-medium text-gray-700">Rol</label>
                <select name="IdRol" class="p-2 rounded-lg border border-gray-300">
                        <option value="">Seleccione Rol</option>
                        @foreach(var Rol in Model.ListaRoles){
                            <option value="@Rol.IdRol">@Rol.Rol1</option>
                        }
                    </select>
            </div>

            <!-- Cantidad de Facturas -->
            <div>
                <label class="block text-sm font-medium text-gray-700">Cantidad de Facturas</label>
                <input name="CantidadFacturas" type="number" placeholder="0"
                    class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring focus:border-blue-300" />
            </div>

            <!-- Contraseña -->
            <div>
                <label class="block text-sm font-medium text-gray-700">Contraseña</label>
                <input name="Contrasena" type="password" placeholder="********"
                    class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring focus:border-blue-300" />
            </div>

            <!-- Botón -->
            
            </div>

            <div class="text-center my-6">
                <button type="submit"
                    class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-6 rounded-lg shadow">
                    Guardar Usuario
                </button>
            </div>

        </form>
    </div>



</div>


@section Scripts {
    <script>
        function mostrarApartado(id) {

            document.getElementById('Lista').classList.add('hidden');
            document.getElementById('Crear').classList.add('hidden');

            document.getElementById('btn-Lista').classList.add('bg-white');
            document.getElementById('btn-Crear').classList.add('bg-white');
            document.getElementById(`btn-Lista`).classList.replace('text-white', 'text-black');
            document.getElementById(`btn-Crear`).classList.replace('text-white', 'text-black');




            document.getElementById(`btn-${id}`).classList.replace('bg-white', 'bg-[#6ca7cf]');
            document.getElementById(`btn-${id}`).classList.replace('text-black', 'text-white');
            document.getElementById(id).classList.remove('hidden');
        }
    </script>
}
