@model TravelingColombia.ViewModels.ReservasGenericoViewModel

<div class="min-h-screen bg-gradient-to-b from-blue-100 to-white flex flex-col items-center p-6 space-y-6">
    <!-- Botones superiores -->
    <div
        class="flex w-full justify-between items-center bg-[#3085BC] rounded-xl shadow-lg p-4 px-16 flex-nowrap overflow-x-auto gap-2">
        <button id="btn-Lista" onclick="mostrarApartado('Lista')"
            class="text-white font-semibold bg-[#6ca7cf] px-4 py-2 rounded-full w-32 md:w-40 h-12">
            Lista
        </button>
        <button id="btn-Crear" onclick="mostrarApartado('Crear')"
            class="text-black font-semibold bg-white px-4 py-2 rounded-full w-32 md:w-40 h-12">
            Crear
        </button>
    </div>

    <!-- Lista de Reservas -->
    <div id="Lista" class="bg-white w-full max-w-[1500px] rounded-2xl p-8">
        <div
            class="relative p-10 rounded-xl bg-[url('https://img.freepik.com/foto-gratis/terminal-aeropuerto_1417-1456.jpg?semt=ais_hybrid&w=740')] bg-cover">
            <h2
                class="relative bottom-18 text-2xl w-[900px] h-[60px] rounded-full border left-60 bg-white font-bold text-center pt-2">
                Gestión de Reservas
            </h2>

            <!-- Formulario de filtros -->
            <form asp-action="Reserva" method="post"
                class="flex flex-wrap gap-x-10 gap-y-5 w-full p-6 bg-white rounded-xl shadow-lg">
                <div class="flex flex-col flex-1 min-w-[200px]">
                    <label class="mb-1 font-semibold text-gray-700">Usuario</label>
                    <select name="IdUsuario" class="p-2 rounded-lg border border-gray-300">
                        <option value="">Todos</option>
                        @foreach (var usuario in Model.ListaUsuarios)
                        {
                            <option value="@usuario.IdUsuario">@usuario.NombreUsuario</option>
                        }
                    </select>
                </div>
                <div class="flex flex-col flex-1 min-w-[200px]">
                    <label class="mb-1 font-semibold text-gray-700">Viaje</label>
                    <select name="IdViaje" class="p-2 rounded-lg border border-gray-300">
                        <option value="">Todos</option>
                        @foreach (var viaje in Model.ListaViajes)
                        {
                            <option value="@viaje.IdViaje">@viaje.IdViaje</option>
                        }
                    </select>
                </div>
                <div class="flex flex-col flex-1 min-w-[200px]">
                    <label class="mb-1 font-semibold text-gray-700">Plan</label>
                    <select name="IdPlan" class="p-2 rounded-lg border border-gray-300">
                        <option value="">Todos</option>
                        @foreach (var plan in Model.ListaPlanes)
                        {
                            <option value="@plan.IdPlan">@plan.NombrePlan</option>
                        }
                    </select>
                </div>
                <div class="flex flex-col flex-1 min-w-[200px]">
                    <label class="mb-1 font-semibold text-gray-700">Fecha de Reserva</label>
                    <input type="date" name="FechaReserva" class="p-2 rounded-lg border border-gray-300" />
                </div>
                <div class="flex flex-col flex-1 min-w-[200px]">
                    <label class="mb-1 font-semibold text-gray-700">Precio Plan</label>
                    <input type="number" step="0.01" name="PrecioPlan" class="p-2 rounded-lg border border-gray-300" />
                </div>
                <div class="flex flex-col flex-1 min-w-[200px]">
                    <label class="mb-1 font-semibold text-gray-700">Precio Viaje</label>
                    <input type="number" step="0.01" name="PrecioViaje" class="p-2 rounded-lg border border-gray-300" />
                </div>
                <div class="flex justify-center w-full mt-4">
                    <button type="submit"
                        class="bg-[#3085BC] hover:bg-[#3084bcd2] text-white font-bold py-3 px-8 rounded-full transition duration-300">
                        Buscar
                    </button>
                </div>
            </form>

            <!-- Tabla de reservas -->
            <div
                class="bg-white w-full max-w-full h-[400px] p-4 mt-6 overflow-x-auto overflow-y-auto rounded-xl shadow-md">
                <table class="min-w-[700px] w-full border-collapse table-auto">
                    <thead>
                        <tr class="bg-[#3085BC] text-white text-sm sm:text-base">
                            <th class="px-4 py-2 border">Id Reserva</th>
                            <th class="px-4 py-2 border">Usuario</th>
                            <th class="px-4 py-2 border">Fecha Reserva</th>
                            <th class="px-4 py-2 border">Tipo</th>
                            <th class="px-4 py-2 border">Monto</th>
                            <th class="px-4 py-2 border">Estado Reserva</th>
                            <th class="px-4 py-2 border">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var reserva in Model.ListadoReservas)
                        {
                            <tr class="text-sm sm:text-base hover:bg-[#3085BC]/30 transition">
                                <td class="px-4 py-2 border">@reserva.IdReserva</td>
                                <td class="px-4 py-2 border">@reserva.NombreUsuario</td>
                                <td class="px-4 py-2 border">@reserva.FechaReserva.ToShortDateString()</td>
                                <td class="px-4 py-2 border">@(reserva.IdPlan != null ? "Plan" : "Viaje")</td>
                                <td class="px-4 py-2 border">@(reserva.IdPlan != null ? reserva.PrecioPlan :
                                                                    reserva.PrecioViaje)</td>
                            <td class="px-4 py-2 border">@reserva.EstadoReserva</td>
                            <td class="flex justify-center gap-2 px-4 py-2 border">
                                <a asp-action="Editar" asp-controller="Reserva" asp-route-id="@reserva.IdReserva"
                                    class="btn btn-sm btn-warning">Editar</a>
                                <form asp-action="Delete" asp-controller="Reserva" asp-route-id="@reserva.IdReserva"
                                    method="post" onsubmit="return confirm('¿Estás seguro de eliminar esta Reserva?');"
                                    class="inline">
                                    <button type="submit" class="btn btn-sm btn-error">Eliminar</button>
                                </form>
                            </td>
                        </tr>
                                                }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Crear Reserva -->
    <div id="Crear" class="max-w-3xl mx-auto mt-10 bg-white p-8 rounded-lg shadow-lg">
        <h2 class="text-2xl font-bold mb-6 text-center text-[#38BDF8]">Editar Reserva</h2>

        <form asp-action="Crear" method="post" class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <input type="hidden" name="IdReserva" />

            <div>
                <label for="FechaReserva" class="block text-gray-700 font-semibold mb-1">Fecha de Reserva</label>
                <input type="date" name="FechaReserva" class="w-full px-4 py-2 border border-gray-300 rounded-lg"
                    required />
            </div>
            <div>
                <label for="IdViaje" class="block text-gray-700 font-semibold mb-1">ID del Viaje</label>
                <input type="number" name="IdViaje" class="w-full px-4 py-2 border border-gray-300 rounded-lg" />
            </div>
            <div>
                <label for="IdEstadoReserva" class="block text-gray-700 font-semibold mb-1">Estado</label>
                <select name="IdEstadoReserva" class="w-full px-4 py-2 border border-gray-300 rounded-lg" required>
                    <option value="">Seleccione estado</option>
                    <option value="1">Pendiente</option>
                    <option value="2">Confirmada</option>
                    <option value="3">Cancelada</option>
                </select>

            </div>
            <div>
                <label for="IdUsuario" class="block text-gray-700 font-semibold mb-1">ID del Usuario</label>
                <input type="number" name="IdUsuario" class="w-full px-4 py-2 border border-gray-300 rounded-lg"
                    required />
            </div>
            <div>
                <label for="IdPlan" class="block text-gray-700 font-semibold mb-1">ID del Plan</label>
                <input type="number" name="IdPlan" class="w-full px-4 py-2 border border-gray-300 rounded-lg" />
            </div>
            <div class="md:col-span-2 flex justify-center">
                <button type="submit"
                    class="bg-[#F59E0B] text-white font-bold py-2 px-6 rounded-lg hover:bg-[#fbbf24] transition duration-300">
                    Guardar Cambios
                </button>
            </div>
        </form>
    </div>

@section Scripts {
        <script>
            function mostrarApartado(id) {
                document.getElementById('Lista').classList.add('hidden');
                document.getElementById('Crear').classList.add('hidden');
                document.getElementById('btn-Lista').classList.replace('bg-[#6ca7cf]', 'bg-white');
                document.getElementById('btn-Crear').classList.replace('bg-[#6ca7cf]', 'bg-white');
                document.getElementById('btn-Lista').classList.replace('text-white', 'text-black');
                document.getElementById('btn-Crear').classList.replace('text-white', 'text-black');

                document.getElementById(id).classList.remove('hidden');
                document.getElementById(`btn-${id}`).classList.replace('bg-white', 'bg-[#6ca7cf]');
                document.getElementById(`btn-${id}`).classList.replace('text-black', 'text-white');
            }

            // Mostrar lista por defecto al cargar
            document.addEventListener('DOMContentLoaded', function () {
                mostrarApartado('Lista');
            });
        </script>
}
