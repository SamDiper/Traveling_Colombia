@model TravelingColombia.Filtros.FiltroReservasViewModel

@{
    ViewData["Title"] = "Editar Reserva";
}

<h2 class="text-2xl font-bold mb-6 text-gray-800">Editar Reserva</h2>

<form asp-action="Editar" method="post" class="max-w-xl mx-auto bg-white p-6 shadow-md rounded-lg">
    <input type="hidden" asp-for="IdReserva" />

    <div class="mb-4">
        <label asp-for="IdUsuario" class="block text-gray-700 font-semibold mb-1"></label>
        <input asp-for="IdUsuario" class="w-full px-4 py-2 border border-gray-300 rounded-lg" readonly/>
        <span asp-validation-for="IdUsuario" class="text-red-600 text-sm"></span>
    </div>

    @if (Model.IdPlan != null)
    {
        <div class="mb-4">
            <label asp-for="IdPlan" class="block text-gray-700 font-semibold mb-1">Plan</label>
            <select asp-for="IdPlan" class="w-full px-4 py-2 border border-gray-300 rounded-lg" asp-items="ViewBag.Planes">
                <option value="">Seleccione un plan</option>
            </select>
        </div>
    }
    else if (Model.IdViaje != null)
    {
        <div class="mb-4">
            <label asp-for="IdViaje" class="block text-gray-700 font-semibold mb-1">Viaje</label>
            <select asp-for="IdViaje" class="w-full px-4 py-2 border border-gray-300 rounded-lg" asp-items="ViewBag.Viajes">
                <option value="">Seleccione un viaje</option>
            </select>
        </div>
    }
    else
    {
        <div class="mb-4 text-yellow-700 font-semibold">No hay plan ni viaje asociado.</div>
    }

    <div class="mb-4">
        <label asp-for="FechaReserva" class="block text-gray-700 font-semibold mb-1"></label>
        <input asp-for="FechaReserva" type="date" class="w-full px-4 py-2 border border-gray-300 rounded-lg" />
        <span asp-validation-for="FechaReserva" class="text-red-600 text-sm"></span>
    </div>

    <div class="mb-4">
        <label asp-for="IdEstadoReserva" class="block text-gray-700 font-semibold mb-1"></label>
        <select asp-for="IdEstadoReserva" class="w-full px-4 py-2 border border-gray-300 rounded-lg" asp-items="ViewBag.Estados">
            <option value="">Seleccione un estado</option>
        </select>
        <span asp-validation-for="IdEstadoReserva" class="text-red-600 text-sm"></span>
    </div>

    <div class="flex justify-end space-x-4">
        <button type="submit" class="bg-blue-600 text-white px-5 py-2 rounded-lg hover:bg-blue-700 transition duration-200">Guardar cambios</button>
        <a asp-action="Index" class="bg-gray-300 text-gray-800 px-5 py-2 rounded-lg hover:bg-gray-400 transition duration-200">Cancelar</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
