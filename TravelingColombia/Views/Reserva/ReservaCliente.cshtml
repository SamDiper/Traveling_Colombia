@model TravelingColombia.ViewModels.ReservasGenericoViewModel

<div class="min-h-screen w-screen bg-gradient-to-b flex flex-col items-center p-6 space-y-6">
    <div id="Lista" class="bg-white w-full max-w-[1700px] rounded-2xl p-8">
        <div
            class="relative p-10 rounded-xl bg-[url('https://img.freepik.com/foto-gratis/terminal-aeropuerto_1417-1456.jpg?semt=ais_hybrid&w=740')] bg-cover">
            <h2
                class="relative bottom-18 text-2xl w-[900px] h-[60px] rounded-full border left-60 bg-white font-bold text-center pt-2">
                Gestion de Reservas
            </h2>

            <!-- Formulario de filtros -->
            <form asp-action="Reserva" method="post"
                class="flex flex-wrap gap-x-10 gap-y-5 w-full p-6 bg-white rounded-xl shadow-lg">

                <!-- Nombre Usuario -->
                <div class="flex flex-col flex-1 min-w-[200px]">
                    <label class="mb-1 font-semibold text-gray-700">Usuario</label>
                    <select name="IdUsuario" class="p-2 rounded-lg border border-gray-300">
                        <option value="">Todos</option>
                        @foreach (var usuario in Model.ListaUsuarios)
                        {
                            <option value="@usuario.IdUsuario">@usuario.NombreUsuario</option>
                        }
                    </select>
                </div>

                <!-- Viaje -->
                <div class="flex flex-col flex-1 min-w-[200px]">
                    <label class="mb-1 font-semibold text-gray-700">Viaje</label>
                    <select name="IdViaje" class="p-2 rounded-lg border border-gray-300">
                        <option value="">Todos</option>
                        @foreach (var viaje in Model.ListaViajes)
                        {
                            <option value="@viaje.IdViaje">@viaje.IdViaje</option>
                        }
                    </select>
                </div>

                <!-- Plan -->
                <div class="flex flex-col flex-1 min-w-[200px]">
                    <label class="mb-1 font-semibold text-gray-700">Plan</label>
                    <select name="IdPlan" class="p-2 rounded-lg border border-gray-300">
                        <option value="">Todos</option>
                        @foreach (var plan in Model.ListaPlanes)
                        {
                            <option value="@plan.IdPlan">@plan.NombrePlan</option>
                        }
                    </select>
                </div>

                <!-- Fecha Reserva -->
                <div class="flex flex-col flex-1 min-w-[200px]">
                    <label class="mb-1 font-semibold text-gray-700">Fecha de Reserva</label>
                    <input type="date" name="FechaReserva" class="p-2 rounded-lg border border-gray-300" />
                </div>

                <!-- Precio Plan -->
                <div class="flex flex-col flex-1 min-w-[200px]">
                    <label class="mb-1 font-semibold text-gray-700">Precio Plan</label>
                    <input type="number" step="0.01" name="PrecioPlan" class="p-2 rounded-lg border border-gray-300" />
                </div>

                <!-- Precio Viaje -->
                <div class="flex flex-col flex-1 min-w-[200px]">
                    <label class="mb-1 font-semibold text-gray-700">Precio Viaje</label>
                    <input type="number" step="0.01" name="PrecioViaje" class="p-2 rounded-lg border border-gray-300" />
                </div>

                <!-- Botón buscar -->
                <div class="flex justify-center w-full mt-4">
                    <button type="submit"
                        class="bg-[#3085BC] hover:bg-[#3084bcd2] text-white font-bold py-3 px-8 rounded-full transition duration-300">
                        Buscar
                    </button>
                </div>
            </form>

            <!-- Tabla de resultados -->
            <div
                class="bg-white w-full max-w-full h-[400px] p-4 mt-6 overflow-x-auto overflow-y-auto rounded-xl shadow-md">
                <table class="min-w-[900px] w-full border-collapse table-auto">
                    <thead>
                        <tr class="bg-[#3085BC] text-white text-sm sm:text-base">
                            <th class="px-4 py-2 border text-center">Fecha Reserva</th>
                            <th class="px-4 py-2 border text-center">Cliente</th>
                            <th class="px-4 py-2 border text-center">Viaje</th>
                            <th class="px-4 py-2 border text-center">Nombre Plan</th>
                            <th class="px-4 py-2 border text-center">Precio Plan</th>
                            <th class="px-4 py-2 border text-center">Precio Viaje</th>
                            <th class="px-4 py-2 border text-center">Cantidad Personas</th>
                            <th class="px-4 py-2 border text-center">Total Reserva</th>
                            <th class="px-4 py-2 border text-center">Abono</th>
                            <th class="px-4 py-2 border text-center">Estado Reserva</th>
                            <th class="px-4 py-2 border text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.ListadoReservas)
                        {
                            
                               @if(item.EstadoReserva!="Cancelado"){
                                <tr class="text-sm sm:text-base hover:bg-[#3085BC]/30 transition">
                                <td class="px-4 py-2 border">@item.FechaReserva.ToString("yyyy-MM-dd")</td>
                                <td class="px-4 py-2 border">@item.NombreUsuario</td>
                                <td class="px-4 py-2 border">@item.NombreViaje</td>
                                <td class="px-4 py-2 border">@item.NombrePlan</td>
                                <td class="px-4 py-2 border">$@item.PrecioPlan</td>
                                <td class="px-4 py-2 border">$@item.PrecioViaje</td>
                                <td class="px-4 py-2 border">@item.CantidadPersonas.ToString()</td>
                                <td class="px-4 py-2 border ">$@item.TotalReserva.ToString()</td>
                                <td class="px-4 py-2 border ">$@item.PagoUsuario.ToString()</td>
                                <td class="px-4 py-2 border">@item.EstadoReserva</td>
                                <td class="px-4 py-2 border">
                                    <div class="flex justify-between gap-4">
                                    @if(item.EstadoReserva!="Confirmado"){
                                        <form asp-action="Pago" asp-controller="Cliente" asp-route-id="@item.IdReserva"
                                    method="get" 
                                    class="btn bg-white hover:bg-green-600">
                                        <button type="submit" >Pagar</button>
                                    </form>
                                      
                                    
                                    <form asp-action="DeleteReserva" asp-controller="Reserva"  asp-route-id="@item.IdReserva"
                                    method="post" 
                                    class="btn bg-white hover:bg-red-600">
                                        <button type="submit" >Cancelar</button>
                                    </form>
                                    }
                                    </div>
                            </td>
                            </tr>
                               }
                            
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
