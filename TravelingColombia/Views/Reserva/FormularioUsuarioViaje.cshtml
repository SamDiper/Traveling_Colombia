@model TravelingColombia.ViewModels.vistaPagoViewModel

<form asp-action="PagosViajes" asp-controller="Cliente" method="get"
    class="max-w-4xl mx-auto p-8 bg-white rounded-lg shadow-md grid grid-cols-1 md:grid-cols-2 gap-6">
    <h2 class="col-span-2 text-2xl font-bold text-gray-800">Formulario de Reserva</h2>

    <div>
        <label class="block text-sm font-medium text-gray-700">Fecha de Reserva</label>
        <input type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")" name="Fecha_Reserva"
            class="mt-1 w-full border-gray-300 rounded-md shadow-sm" />
    </div>

    <div>
        <label class="block text-sm font-medium text-gray-700">Fecha de Ida</label>
        <input type="date" value="@Model.viaje.FechaViaje.ToString("yyyy-MM-dd")" name="FechaViaje"
            class="mt-1 w-full border-gray-300 rounded-md shadow-sm" />
    </div>

    <div>
        <label class="block text-sm font-medium text-gray-700">Destino Salida</label>
        <input type="text" value="@Model.viaje.DestinoIda" name="DestinoIda"
            class="mt-1 w-full border-gray-300 rounded-md shadow-sm" />
        <input type="text" value="@Model.viaje.IdViaje" name="IdViaje"
            class="mt-1 w-full border-gray-300 rounded-md shadow-sm hidden" />
    </div>
    <div>
        <label class="block text-sm font-medium text-gray-700">Destino Llegada</label>
        <input type="text" value="@Model.viaje.DestinoLlegada" name="DestinoLlegada"
            class="mt-1 w-full border-gray-300 rounded-md shadow-sm" />
        
    </div>
    <div>
        <label class="block text-sm font-medium text-gray-700">Destino</label>
        <input type="text" value="@Model.viaje.HoraSalida" name="HoraSalida"
            class="mt-1 w-full border-gray-300 rounded-md shadow-sm" />
        
    </div>
    <div>
        <label class="block text-sm font-medium text-gray-700">Destino</label>
        <input type="text" value="@Model.viaje.HoraLlegada" name="HoraLlegada"
            class="mt-1 w-full border-gray-300 rounded-md shadow-sm" />
        
    </div>
    <div>
        <label class="block text-sm font-medium text-gray-700">Destino</label>
        <input type="text" value="@Model.viaje.AerolineaNombre" name="AerolineaNombre"
            class="mt-1 w-full border-gray-300 rounded-md shadow-sm" />
        
    </div>

   
    <div>
        <label class="block text-sm font-medium text-gray-700">Nombre del Usuario</label>
        <input type="text" value="@Model.Usuario.NombreUsuario" name="Nombre_Usuario"
            class="mt-1 w-full border-gray-300 rounded-md shadow-sm" />
    </div>

    <div>
        <label class="block text-sm font-medium text-gray-700">Apellido del Usuario</label>
        <input type="text" value="@Model.Usuario.ApellidoUsuario" name="Apellido_Usuario"
            class="mt-1 w-full border-gray-300 rounded-md shadow-sm" />
    </div>

    <div>
        <label class="block text-sm font-medium text-gray-700">Celular</label>
        <input type="tel" value="@Model.Usuario.CelularUsuario" name="Celular_Usuario"
            class="mt-1 w-full border-gray-300 rounded-md shadow-sm" />
    </div>

    <div>
        <label class="block text-sm font-medium text-gray-700">Email</label>
        <input type="email" value="@Model.Usuario.EmailUsuario" name="Email_Usuario"
            class="mt-1 w-full border-gray-300 rounded-md shadow-sm" />
    </div>

    <div>
        <label class="block text-sm font-medium text-gray-700">Cantidad de Personas</label>
        <input type="text" id="cantidadPersonas" name="CantidadPersonas" min="1"
            class="mt-1 w-full border-gray-300 rounded-md shadow-sm" />
    </div>

    <div class="col-span-2">
        <label class="block text-sm font-medium text-gray-700">Total de la Reserva</label>
        <input type="text" id="totalReserva" name="PrecioViaje" value="@Model.viaje.PrecioViaje"
            class="mt-1 w-full border-gray-300 rounded-md shadow-sm" readonly />
    </div>

    <div class="col-span-2 flex justify-end">
        <button type="submit"
            class="btn bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700 transition-colors">Realizar
            Reserva</button>
    </div>
</form>

@section Scripts{
    <script>
    document.addEventListener("DOMContentLoaded", function () {
        const CantidadPersonas = document.getElementById("cantidadPersonas");
        const totalReserva = document.getElementById("totalReserva");

        // Guardamos el precio original del plan
        const precioBase = parseFloat(totalReserva.value);

        // Evento que se activa al cambiar la cantidad
        CantidadPersonas.addEventListener("input", function () {
            const cantidad = parseInt(CantidadPersonas.value) || 0;
            totalReserva.value = cantidad * precioBase;
        });
    });
</script>
}