@model TravelingColombia.ViewModels.PlanesViewModel

<div class="min-h-screen bg-gradient-to-b  flex flex-col items-center p-6 space-y-6">
    <!-- Botones superiores -->
    <div
        class="flex w-full justify-between items-center bg-[#3085BC]  rounded-xl shadow-lg p-4 px-16 flex-nowrap overflow-x-auto gap-2">

        <button id="btn-Lista" onclick="mostrarApartado('Lista')" class="text-black cursor-pointer bg-[#6ca7cf]  px-2 py-1 rounded-full 
               text-sm sm:text-base md:text-lg 
               w-24 sm:w-28 md:w-32 lg:w-40 
               h-10 sm:h-12 md:h-14">
            Lista
        </button>

        <button id="btn-Crear" onclick="mostrarApartado('Crear')" class="text-black cursor-pointer bg-white font-semibold px-2 py-1 rounded-full 
               text-sm sm:text-base md:text-lg 
               w-24 sm:w-28 md:w-32 lg:w-40 
               h-10 sm:h-12 md:h-14">
            Crear
        </button>

    </div>



    <!-- Contenedor de viajes -->
    <div id="Lista" class="bg-white w-full max-w-[1700px] rounded-2xl p-8 ">
        <div
            class="relative p-10 rounded-xl bg-[url('https://img.freepik.com/foto-gratis/terminal-aeropuerto_1417-1456.jpg?semt=ais_hybrid&w=740')] bg-cover ">
            <h2
                class="relative bottom-18  text-2xl w-[900px] h-[60px] rounded-full  border left-80 bg-white font-bold text-center pt-2">
                Gestion de Planes</h2>
            <!-- Formulario -->
             <form method="post" asp-action="Index" asp-controller="Plan" class="flex flex-wrap gap-x-10 gap-y-5 w-full p-6 bg-white rounded-xl shadow-lg">

                <!-- Campos personalizados -->
                <div class="flex flex-col flex-1 min-w-[200px]">
                    <label class="mb-1 font-semibold text-gray-700">Destino</label>
                    <input name="NombreDestino" type="text" placeholder="Ingrese Destino" class="p-2 rounded-lg border border-gray-300" />
                </div>
                <div class="flex flex-col flex-1 min-w-[200px]">
                    <label class="mb-1 font-semibold text-gray-700">Plan</label>
                    <input name="NombrePlan" type="text" placeholder="Nombre Plan" class="p-2 rounded-lg border border-gray-300" />
                </div>
                <div class="flex flex-col flex-1 min-w-[200px]">
                    <label class="mb-1 font-semibold text-gray-700">Tipo Plan</label>
                     <select name="IdTipoPlan" class="p-2 rounded-lg border border-gray-300">
                     <option value="">Seleccione Tipo</option>
                    @foreach (var tipoplan in Model.ListadoTipoPlanes)
                    {
                       
                            
                            <option value="@tipoplan.IdTipoPlan">@tipoplan.NombrePlan</option>
                        
                    }
                    </select>
                </div>

                <div class="flex flex-col flex-1 min-w-[200px]">
                    <label class="mb-1 font-semibold text-gray-700">Fecha </label>
                    <input name="Fecha" type="date" class="p-2 rounded-lg border border-gray-300" />
                </div>
                
                <div class="flex flex-col flex-1 min-w-[200px]">
                    <label class="mb-1 font-semibold text-gray-700">Precio</label>
                    <input name="Precio" type="number" placeholder="Ingrese precio "
                        class="p-2 rounded-lg border border-gray-300" />
                </div>
                

                <!-- Botón buscar -->
                <div class="flex justify-center w-full mt-4">
                    <button type="submit"
                        class="bg-[#3085BC] hover:bg-[#3084bcd2] text-white font-bold py-3 px-8 rounded-full transition duration-300">
                        Listar
                    </button>
                </div>
            </form>

            <!-- Tabla de planes -->
            <div
                class="bg-white w-full max-w-full h-[400px] p-4 mt-6 overflow-x-auto overflow-y-auto rounded-xl shadow-md">
               <table class="min-w-[700px] w-full  border-collapse table-auto">
                    <thead>
                        <tr class="bg-[#3085BC] text-white text-sm sm:text-base">
                            <th class="px-4 py-2 border">Destino</th>
                            <th class="px-4 py-2 border">País</th>
                            <th class="px-4 py-2 border">Plan</th>
                            <th class="px-4 py-2 border">Fecha Ida</th>
                            <th class="px-4 py-2 border">Fecha Regreso</th>
                            <th class="px-4 py-2 border">Tipo</th>
                            <th class="px-4 py-2 border">Introduccion</th>
                            
                            <th class="px-4 py-2 border">Personas</th>
                            <th class="px-4 py-2 border">Imagen</th>
                            <th class="px-4 py-2 border">Precio</th>
                            <th class="px-4 py-2 border">Hotel</th>
                            <th class="px-4 py-2 border">Aerolínea</th>
                            <th class="px-4 py-2 border">Acciones</th>
                        </tr>

                    </thead>
                    <tbody>

                        @foreach (var plan in Model.ListadoPlanes)
                        {
                            <tr class="hover:bg-gray-50">
                                <td class="px-4 py-2 border">@plan.DestinoIda</td>
                                <td class="px-4 py-2 border">@plan.Pais</td>
                                <td class="px-4 py-2 border">@plan.NombrePlan</td>
                                <td class="px-4 py-2 border">@plan.FechaIda</td>
                                <td class="px-4 py-2 border">@plan.FechaRegreso</td>
                                <td class="px-4 py-2 border">@plan.TipoPlan</td>
                                <td class="px-4 py-2 border">@plan.Introduccion</td>                               
                                <td class="px-4 py-2 border">@plan.CantidadPersonas</td>
                                <td class="px-4 py-2 border">
                                    <img src="@plan.Imagen" 
                                        class="w-16 h-16 object-cover rounded-md" />
                                </td>
                                <td class="px-4 py-2 border">$@plan.PrecioPlan</td>
                                <td class="px-4 py-2 border">@plan.Hotel</td>
                                <td class="px-4 py-2 border">@plan.Aerolinea</td>
                                <td class="px-4 py-2 border">
                                    <div class="flex justify-between gap-4">
                                        <a asp-action="Editar" asp-controller="Plan" asp-route-id="@plan.IdPlan" class="btn bg-white hover:bg-yellow-600">Editar</a>
                                        <a asp-action="Eliminar" asp-controller="Plan" asp-route-id="@plan.IdPlan" class="btn bg-white hover:bg-red-600">Eliminar</a>
                                        

                                    </div>
                                </td>

                            </tr>
                        }

                    </tbody>
                </table>
            </div>

        </div>
    </div>

    <!-- contenedor formulario viajes-->
    <div id="Crear" class="max-w-4xl mx-auto mt-10 bg-white p-8 rounded-lg shadow-lg hidden">
        <h2 class="text-2xl font-bold mb-6 text-center text-[#3085BC]">Registrar Plan Turístico</h2>

        <form method="post" asp-action="Crear" asp-controller="Plan" class="grid grid-cols-1 md:grid-cols-2 gap-6">


            <!-- Id_Destino_Ida -->
            <div>
                <label for="tipo_plan" class="block text-gray-700 font-semibold mb-1">Destino</label>
                <select id="tipo_plan" name="IdDestinoIda"
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#3085BC]"
                    required>
                    <option value="">Seleccione una opción</option>
                    @foreach (var Destino in Model.ListadoDestino)
                    {   
                        <option value="@Destino.IdDestino">@Destino.NombreDestino</option>
                    }
                </select>
            </div>

            
            <!-- Nombre_Plan -->
            <div>
                <label for="nombre_plan" class="block text-gray-700 font-semibold mb-1">Nombre del Plan</label>
                <input type="text" id="nombre_plan" name="NombrePlan" 
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#3085BC]"
                    required />
            </div>
            <div>
                <label for="nombre_plan" class="block text-gray-700 font-semibold mb-1">Introduccion</label>
                <input type="text" id="nombre_plan" name="Introduccion" 
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#3085BC]"
                    required />
            </div>

            <!-- Id_tipo_plan -->
            <div>
                <label for="tipo_plan" class="block text-gray-700 font-semibold mb-1">Tipo de Plan</label>
                <select id="tipo_plan" name="IdTipoPlan"
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#3085BC]"
                    required>
                    <option value="">Seleccione una opción</option>
                    @foreach (var tipoplan in Model.ListadoTipoPlanes)
                    {   
                        <option value="@tipoplan.IdTipoPlan">@tipoplan.NombrePlan</option>
                    }
                </select>
            </div>
            <div>
                <label for="FechaIda" class="block text-gray-700 font-semibold mb-1">Fecha Ida</label>
                <input type="date" id="FechaIda" name="FechaIda" 
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#3085BC]"
                    required />
            </div>
            <div>
                <label for="FechaRegreso" class="block text-gray-700 font-semibold mb-1">Fecha Regreso</label>
                <input type="date" id="FechaRegreso" name="FechaRegreso" 
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#3085BC]"
                    required />
            </div>

            
            <!-- Cantidad_Personas -->
            <div>
                <label for="cantidad" class="block text-gray-700 font-semibold mb-1">Cantidad de Personas</label>
                <input type="number" id="cantidad" name="CantidadPersonas" 
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#3085BC]"
                    required />
            </div>

            <!-- Imagen -->
            <div>
                <label for="imagen" class="block text-gray-700 font-semibold mb-1">Imagen</label>
                <input type="file" id="imagen" name="Imagen"
                    class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#3085BC]" />
            </div>

            <!-- Precio_Plan -->
            <div>
                <label for="precio" class="block text-gray-700 font-semibold mb-1">Precio del Plan</label>
                <input type="number" id="precio" name="PrecioPlan" step="0.01" 
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#3085BC]"
                    required />
            </div>

            <!-- Id_Hotel -->
             <div>
                <label for="tipo_plan" class="block text-gray-700 font-semibold mb-1">Hotel</label>
                <select id="tipo_plan" name="IdHotel"
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#3085BC]"
                    required>
                    <option value="">Seleccione una opción</option>
                     @foreach (var Hotel in Model.ListadoHoteles)
                    {   
                        <option value="@Hotel.IdHotel">@Hotel.NombreHotel</option>
                    }
                </select>
            </div>

            <!-- Id_Aerolinea -->
             <div>
                <label for="tipo_plan" class="block text-gray-700 font-semibold mb-1">Aerolinea</label>
                <select id="tipo_plan" name="IdAerolinea"
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#3085BC]"
                    required>
                    <option value="">Seleccione una opción</option>
                     @foreach (var Aerolinea in Model.ListadoAerolinea)
                    {   
                        <option value="@Aerolinea.IdAerolinea">@Aerolinea.NombreAerolinea</option>
                    }
                </select>
            </div>

            <div class="md:col-span-2">
                <label class="block text-gray-700 font-semibold mb-1">Descripción </label>
                <div id="editor" style="height: 200px; background-color: white;" class="mb-2"></div>
                <input type="hidden" name="Descripcion" id="Descripcion" />
                <div class="md:col-span-2 flex justify-center">
                <button type="button" id="btnGuardarDescripcion"
                    class="bg-yellow-500 text-white font-bold py-2 px-6 rounded-lg hover:bg-yellow-600 transition duration-300 mr-4">
                    Guardar Descripción
                </button>

            </div>


            <!-- Botón de Enviar -->
            <div class="md:col-span-2 flex justify-center">
                <button type="submit" 
                    class="bg-[#3085BC] text-white font-bold py-2 px-6 rounded-lg hover:bg-[#25699a] transition duration-300">
                    Registrar Plan
                </button>
            </div>

        </form>
    </div>



</div>


@section Scripts {
    <script>
        function mostrarApartado(id) {

            document.getElementById('Lista').classList.add('hidden');
            document.getElementById('Crear').classList.add('hidden');

            document.getElementById('btn-Lista').classList.add('bg-white');
            document.getElementById('btn-Crear').classList.add('bg-white');
            document.getElementById(`btn-Lista`).classList.replace('text-white', 'text-black');
            document.getElementById(`btn-Crear`).classList.replace('text-white', 'text-black');




            document.getElementById(`btn-${id}`).classList.replace('bg-white', 'bg-[#6ca7cf]');
            document.getElementById(`btn-${id}`).classList.replace('text-black', 'text-white');
            document.getElementById(id).classList.remove('hidden');
        }



      var quill = new Quill('#editor', {
        theme: 'snow'
    });
    document.getElementById("btnGuardarDescripcion").addEventListener("click", function () {
        var contenido = quill.root.innerHTML;
        document.getElementById("Descripcion").value = contenido;

        alert("Descripción guardada correctamente.");
    });

   
    </script>
 
}
