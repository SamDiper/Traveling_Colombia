@model TravelingColombia.ViewModels.PlanViewModel
<div class="w-11/12 mx-auto mt-10 bg-gray-50 rounded-lg shadow-md overflow-hidden p-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Imagen y descripción -->
        <div class="md:col-span-2">
            <h2 class="text-2xl font-bold mb-4 text-gray-800">@Model.NombrePlan</h2>

            <!-- Carousel -->
            <div class="relative overflow-hidden w-full h-[300px] mb-4" id="carousel">
                <div class="flex transition-transform duration-500 ease-in-out" id="track">
                    <img src="@Model.Imagen" class="w-full h-[300px] flex-shrink-0 rounded-lg" />
                </div>
                <div class="absolute inset-0 flex justify-between items-center px-4">
                    <button id="prev" class="btn btn-circle">❮</button>
                    <button id="next" class="btn btn-circle">❯</button>
                </div>




            </div>

            <!-- Información adicional -->
            <div class="text-gray-600">
                <p><strong>Desde @Model.PrecioPlan</strong> por persona</p>
                <p class="text-sm text-gray-500 mb-2">Ventas del 07 al 30 de abril de 2025</p>
                <p class="text-sm text-gray-500 mb-4">
                    Viaja en fechas puntuales hasta el 30 de diciembre de 2025 como
                    última fecha de regreso (la tarifa varía según la fecha de viaje y hotel elegido).
                </p>
                <h3 class="text-xl font-semibold text-gray-700 mb-2">INCLUYE:</h3>
                @Html.Raw(Model.Descripcion)
            </div>
        </div>

        <!-- Panel lateral de reserva -->
        <div class="rounded-lg p-6 flex flex-col h-full items-center justify-center border border-blue-200 bg-white">
            <div class="w-full rounded-lg p-6 flex flex-col items-center justify-center border border-gray-100">
                <a class="text-lg font-semibold text-gray-700">Reserve Ahora</a>
                <p class="text-gray-400 line-through text-sm">COP Descuento</p>
                <p class="text-2xl font-bold text-[#2E86C1]">COP @Model.PrecioPlan</p>
                <p class="text-sm text-gray-500 mb-4">por persona</p>
                <form method="get" asp-action="FormularioUsuario" asp-controller="Reserva">
                    <input type="text" value="@Model.IdPlan" name="IdPlan" class="hidden">
                    <button  type="submit" 
                    class="btn bg-[#2E86C1] hover:bg-[#245d83] text-white font-semibold py-2 px-4 rounded">
                    Reservar Ahora
                </button>
                    
                </form>
                
            </div>
        </div>
    </div>

</div>
</div>




@section Scripts {
    <script>
        const track = document.getElementById('track');
        const slides = track.children.length;
        let index = 0;

        const move = () => track.style.transform = `translateX(-${index * 100}%)`;

        document.getElementById('next').onclick = () => {
            index = (index + 1) % slides;
            move();
        };

        document.getElementById('prev').onclick = () => {
            index = (index - 1 + slides) % slides;
            move();
        };

        setInterval(() => {
            index = (index + 1) % slides;
            move();
        }, 3000);

    </script>


}