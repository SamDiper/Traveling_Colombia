@{

}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AgenciaViajes</title>
    <script type="importmap"></script>

    <link href="~/css/output.css" rel="stylesheet">
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
        integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>

<body data-theme="light" class="bg-white">

    <!--´parte inferior-->
    <div class="relative">

        <!-- Botón de menú -->
        <div class="navbar bg-[#2e86c1] shadow-sm h-40 ">
            <div class="navbar-start">
                <div class="dropdown">
                    <button id="menuButton" class="fixed top-4 left-4 z-50 rounded bg-[#2e86c1] px-4 py-2 text-white">
                        ☰ Menú
                    </button>
                </div>
            </div>
            <div class="navbar-center">
                <a asp-action="Index" asp-controller="Home">
                    <img class="w-30 h-30 rounded-full"
                        src="https://res.cloudinary.com/dezff5yvd/image/upload/v1746645460/Traveling_colombia_emyqpp.png"
                        alt="">
                </a>
            </div>
        </div>

        <!-- Overlay -->
        <div id="overlay"></div>

        <!-- Contenedor con Sidebar + Main -->
        <div class="relative flex">

            <!-- Sidebar -->
            <aside id="sidebar"
                class="fixed top-0 left-0 z-50 h-full w-64 transform -translate-x-full bg-gradient-to-b from-[#2E86C1] to-[#85C1E9] text-white transition-transform duration-300 overflow-hidden"
                style="clip-path: ellipse(100% 100% at 0% 50%);">

                @if (User.Identity.IsAuthenticated)
                {
                    <!-- Navegación -->
                    <nav class="px-4 py-6 space-y-4 text-sm font-medium">
                        <div class="text-lg font-bold text-center pb-2 border-b border-white mb-4">Menú</div>

                        @if (User.IsInRole("Administrador") || User.IsInRole("Planificador"))
                        {
                            <div>
                                <button onclick="toggleAccordion('teamsMenu')"
                                    class="w-full text-left hover:text-yellow-300 transition-colors duration-200">
                                    Gestión ▾
                                </button>
                                <div id="teamsMenu" class="ml-4 mt-1 hidden space-y-1">
                                    <a asp-action="Index" asp-controller="Usuario"
                                        class="block hover:text-yellow-300">Usuarios</a>
                                    <a asp-action="Index" asp-controller="Viaje" class="block hover:text-yellow-300">Viajes</a>
                                    <a asp-action="Index" asp-controller="Plan" class="block hover:text-yellow-300">Planes</a>
                                    <a asp-action="Index" asp-controller="Pago" class="block hover:text-yellow-300">Pagos</a>
                                    <a asp-action="Index" asp-controller="Reserva"
                                        class="block hover:text-yellow-300">Reservas</a>
                                </div>
                            </div>
                        }

                        @if (User.IsInRole("Cliente"))
                        {
                            <a asp-action="ReservaCliente" asp-controller="Reserva"
                                class="block hover:text-yellow-300">Reservas</a>
                        }

                        @if (User.IsInRole("Administrador"))
                        {
                            <button onclick="toggleAccordion('accountMenu')"
                                class="w-full text-left hover:text-yellow-300 transition-colors duration-200">
                                Informes ▾
                            </button>
                            <div id="accountMenu" class="ml-4 mt-1 hidden space-y-1">
                                <a asp-action="Viaje" asp-controller="Informe" class="block hover:text-yellow-300">Viajes</a>
                                <a asp-action="Plan" asp-controller="Informe" class="block hover:text-yellow-300">Planes</a>
                                <a asp-action="Pago" asp-controller="Informe" class="block hover:text-yellow-300">Pagos</a>
                                <a asp-action="Reserva" asp-controller="Informe"
                                    class="block hover:text-yellow-300">Reservas</a>
                            </div>
                        }

                        <a asp-action="Perfil" asp-controller="Cliente" class="block hover:text-yellow-300">Perfil</a>
                    </nav>

                    <!-- Usuario -->
                    <div class="px-4 py-4 mt-auto flex items-center space-x-4 border-t border-white">
                        <div class="w-10 h-10 rounded-full overflow-hidden border-2 border-white">
                            <img src="@User.FindFirst("FotoUsuario")?.Value" class="w-full h-full object-cover"
                                alt="Foto de perfil" />
                        </div>
                        <div class="text-sm text-white">
                            <div class="font-semibold">@User.FindFirst("Nombre")?.Value</div>
                            <div>@User.FindFirst("Apellido")?.Value</div>
                        </div>
                        <a asp-action="Salir" asp-controller="Cliente"
                            class="text-white hover:text-red-400 ml-auto text-xl">
                            <i class="fa-solid fa-right-from-bracket"></i>
                        </a>
                    </div>
                }
                else
                {
                    <div class="px-4 py-4 mt-auto">
                        <a asp-action="Login" asp-controller="Cliente"
                            class="w-full bg-white text-[#2E86C1] font-semibold py-2 rounded hover:bg-gray-300">
                            Inicia sesión
                        </a>
                    </div>
                }

                <!-- Botón cerrar -->
                <div class="px-4 pb-4">
                    <button id="closeSidebar"
                        class="w-[150px] bg-white text-[#2E86C1] font-semibold py-2 rounded hover:bg-gray-300">
                        Cerrar
                    </button>
                </div>
            </aside>




            <!-- Contenido Principal -->
            <main id="mainContent" class="flex-1 bg-white p-6 text-black transition-all duration-300">

                @RenderBody()
            </main>
        </div>

    </div>



    </div>

    <!-- Navbar inferior -->
    <nav id="bottomNavbar"
        class="fixed right-0 bottom-0 left-0 z-40 ml-0 flex justify-around bg-[#2e86c1] p-3 text-white shadow-inner transition-all duration-300">
        <a asp-action="Index" asp-controller="Home" class="hover:text-yellow-300 ">Inicio</a>
        <a asp-action="Perfil" asp-controller="Cliente" class="hover:text-yellow-300">Perfil</a>
        <a href="https://www.instagram.com/traveling._.colombia" target="_blank"
            class="hover:text-yellow-300">Instagram</a>
    </nav>

    <script>

        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('overlay');
        const menuButton = document.getElementById('menuButton');
        const closeSidebar = document.getElementById('closeSidebar');
        const mainContent = document.getElementById('mainContent');
        const bottomNavbar = document.getElementById('bottomNavbar');

        menuButton.addEventListener('click', () => {
            sidebar.classList.remove('-translate-x-full');
            overlay.classList.remove('hidden');
            mainContent.classList.add('ml-64');
            bottomNavbar.classList.add('ml-64');
        });

        closeSidebar.addEventListener('click', () => {
            sidebar.classList.add('-translate-x-full');
            overlay.classList.add('hidden');
            mainContent.classList.remove('ml-64');
            bottomNavbar.classList.remove('ml-64');
        });

        overlay.addEventListener('click', () => {
            sidebar.classList.add('-translate-x-full');
            overlay.classList.add('hidden');
            mainContent.classList.remove('ml-64');
            bottomNavbar.classList.remove('ml-64');
        });

        function toggleAccordion(id) {
            const el = document.getElementById(id);
            el.classList.toggle('hidden');
        }
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
