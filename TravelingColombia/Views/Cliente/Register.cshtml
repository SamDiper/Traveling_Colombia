@model TravelingColombia.ViewModels.UsuarioViewModel

<body class="overflow-hidden">
    <div class="border-1 border-black-500 h-[75vh] overflow-hidden relative bg-white">

        <div
            class="bg-[#2E86C1] absolute top-[-28%] left-[18%] -translate-x-1/2 w-[900px] h-[900px] rounded-full border-2 border-black-500 shadow-2xl bg-gradient-to-br from-gray-300 via-blue-200 to-[#2E86C1] bg-opacity-100">
        </div>
        <div
            class="bg-[#2E86C1] absolute top-[40%] right-[80%] w-[500px] h-[500px] rounded-full border-2 border-black-500 bg-gradient-to-br from-gray-300 via-blue-200 to-[#2E86C1] bg-opacity-100">
        </div>
        <div
            class="bg-[#2E86C1] absolute top-[-25%] left-[15%] -translate-x-1/2 w-[800px] h-[800px] rounded-full border-2 border-black-500 shadow-2xl overflow-hidden bg-gradient-to-br from-gray-300 via-blue-200 to-[#2E86C1] bg-opacity-100">
            <img src="https://imagenes.eltiempo.com/files/image_1200_535/uploads/2023/06/08/64821418dcfd5.jpeg"
                alt="Familia subiendo al avión" class="absolute top-[23%] left-[16%] h-[620px] object-cover" />
        </div>

        <div
            class="bg-[#2E86C1] absolute top-[50%] right-[55%] w-[350px] h-[350px] flex items-center justify-center rounded-full border-2 border-black-500 shadow-lg bg-gradient-to-l from-[#2E86C1] via-blue-200 to-gray-300 bg-opacity-100">
            <img src="https://res.cloudinary.com/dezff5yvd/image/upload/v1746645460/Traveling_colombia_emyqpp.png"
                alt="Logo Traveling Colombia" class="w-[280px] rounded-full border-2 border-black-500" />
        </div>

        <div
            class="bg-[#2E86C1] absolute top-[5%] right-[22%] w-[500px] p-11 rounded-3xl border-2 border-[#2E86C1] shadow-2xl bg-gradient-to-tr to-gray-100  from-[#d9d9d9] bg-opacity-100 z-10">

            <h2 class="text-center text-5xl font-bold mb-4">Registro</h2>
            <p class="text-center text-base text-gray-700 mb-6">Información personal:</p>
            <form asp-action="Crear" asp-controller="Usuario" method="post" class="grid grid-cols-2 gap-2 space-y-4" enctype="multipart/form-data">

                <!-- Nombre -->
                <div>
                    <label for="NombreUsuario" class="block text-sm font-medium text-gray-700">Nombre</label>
                    <input type="text" id="NombreUsuario" name="NombreUsuario" required
                        class="mt-1 w-50 px-4 py-2 border bg-white border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-cyan-600" />
                </div>

                <!-- Apellido -->
                <div>
                    <label for="ApellidoUsuario" class="block text-sm font-medium text-gray-700">Apellido</label>
                    <input type="text" id="ApellidoUsuario" name="ApellidoUsuario" required
                        class="mt-1 w-50 px-4 py-2 border bg-white border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-cyan-600" />
                </div>
                
                <!-- Cedula -->
                <div>
                    <label for="CedulaUsuario" class="block text-sm font-medium text-gray-700">Cedula</label>
                    <input type="text" id="CedulaUsuario" name="CedulaUsuario" required
                        class="mt-1 w-50 px-4 py-2 border bg-white border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-cyan-600" />
                </div>

                <!-- Celular -->
                <div>
                    <label for="CelularUsuario" class="block text-sm font-medium text-gray-700">Celular</label>
                    <input type="text" id="CelularUsuario" name="CelularUsuario" required
                        class="mt-1 w-full px-4 py-2 border bg-white border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-cyan-600" />
                </div>

                <!-- Email -->
                <div>
                    <label for="EmailUsuario" class="block text-sm font-medium text-gray-700">Email</label>
                    <input type="email" id="EmailUsuario" name="EmailUsuario" required
                        class="mt-1 w-full px-4 py-2 border bg-white border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-cyan-600" />
                </div>

                <!-- Edad -->
                <div>
                    <label for="EdadUsuario" class="block text-sm font-medium text-gray-700">Edad</label>
                    <input type="number" id="EdadUsuario" name="EdadUsuario" min="0" required
                        class="mt-1 w-full px-4 py-2 border bg-white border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-cyan-600" />
                </div>


                <!-- Contraseña -->
                <div>
                    <label for="Contrasena" class="block text-sm font-medium text-gray-700">Contraseña</label>
                    <input type="password" id="Contrasena" name="Contrasena" required
                        class="mt-1 w-full px-4 py-2 border bg-white border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-cyan-600" />
                </div>

                <!-- Rol -->
                <div>
                    <label for="IdRol" class="block text-sm font-medium text-gray-700">Rol</label>
                    <select id="IdRol" name="IdRol" required
                        class="mt-1 w-full px-4 py-2 border bg-white border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-cyan-600">
                        <option value="">-- Selecciona un rol --</option>
                            @foreach (var rol in Model.ListaRoles) {
                                <option value="@rol.IdRol">@rol.Rol1</option>
                            }
                    </select>
                </div>

                <!-- Imagen -->
                <div>
                    <label class="block text-sm font-medium text-gray-700">Imagen</label>
                    <input type="file" name="ImagenArchivo" accept="image/*"
                        class="mt-1 block w-full text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" />
                </div>
                <!-- Botón -->
                <div class="pt-4 text-right">
                    <button type="submit"
                        class="rounded bg-[#2e86c1] px-6 py-2 font-bold text-white shadow-md transition hover:bg-[#3084bcd2]">
                        Registrar
                    </button>
                </div>

            </form>

            <p class="mt-6 text-center text-sm text-gray-600">
                ¿Ya tienes cuenta?
                <a asp-action="Login" asp-controller="Cliente" class="text-blue-600 hover:underline">Ingresar Aquí</a>
            </p>
        </div>


        <div
            class="bg-[#2E86C1] absolute bottom-[-20%] left-[84%] w-[400px] h-[400px] rounded-full border-2 border-black-500 bg-gradient-to-t from-gray-300 via-blue-200 to-[#2E86C1]  bg-opacity-100">
        </div>

        <div
            class="bg-[#2E86C1] absolute bottom-[-10%] right-[-2%] w-[250px] h-[250px] flex items-center justify-center rounded-full border-2 border-black-500 shadow-lg bg-gradient-to-tl from-gray-300 via-blue-200 to-[#2E86C1] bg-opacity-100">
        </div>

        <div class="absolute bottom-[5%] right-[20%] text-sm text-gray-800">
            <b>TRAVELING COLOMBIA es la agencia de vuelos que te permite viajar por todo el mundo <br>
                <center> y hacer tus reservas
                    de forma rápida y segura.</center>
            </b>
        </div>
    </div>
</body>
