@model TravelingColombia.ViewModels.UsuarioViewModel

<form method="post" asp-action="Editar" asp-controller="Usuario" enctype="multipart/form-data">
    <div class="min-h-screen flex flex-col items-center bg-white p-6 rounded-[50px]">

        <!-- Banner superior -->
        <div class=" border-2 border-[#3085BC] w-full relative bg-gradient-to-b from-[#3085BC] to-[#ffff] h-[250px] rounded-t-2xl flex items-center justify-center shadow-md">
            <div class="absolute top-6 right-6 ">
                <a asp-action="Index" asp-controller="Home"
                    class="bg-white text-[#3085BC] hover:bg-[#3085BC] hover:text-white border border-[#3085BC] text-sm px-4 py-2 rounded-full font-semibold shadow-md">
                    Atrás
                </a>
            </div>
            
                @if (!string.IsNullOrEmpty(Model.FotoUsuario))
                {
                    <div class="absolute -bottom-19">
                        <div class="w-[250px] h-[250px] rounded-full border-4 border-[#3085BC] shadow-lg overflow-hidden">
                        <img src="@Model.FotoUsuario" alt="Imagen viaje" class="w-[250px] h-[250px] rounded-md" />
                        </div>
                    </div>
                }
                else{
                    <div class="absolute -bottom-16">
                        <div class="w-[250px] h-[250px] rounded-full border-4 border-white shadow-lg overflow-hidden">
                        <img src="https://static.vecteezy.com/system/resources/previews/005/544/718/non_2x/profile-icon-design-free-vector.jpg" alt="Imagen viaje" class="w-[250px] h-[250px] rounded-md" />
                        </div>
                    </div>
                }
        </div>
        

        <!-- Formulario principal -->
        <div class="w-full max-w-4xl bg-gradient-to-t from-gray-300 to-[#ffff] border border-[#3085BC] mt-20 p-8 rounded-2xl shadow-md">
            <h1 class="text-2xl font-bold text-[#3085BC] mb-6 text-center">Editar Usuario</h1>

            <div class="mb-6">
                <label class="block text-sm font-medium text-gray-700 mb-1">Cambiar Imagen</label>
                <input type="file" name="ImagenArchivo" accept="image/*"
                    class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" />
            </div>

            <input type="hidden" name="IdUsuario" value="@Model.IdUsuario" />

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700">Nombre</label>
                    <input name="NombreUsuario" value="@Model.NombreUsuario" type="text"
                        class="w-full px-4 py-2 rounded border border-gray-300 focus:outline-none focus:ring-2 focus:ring-[#3085BC]" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700">Apellido</label>
                    <input name="ApellidoUsuario" value="@Model.ApellidoUsuario" type="text"
                        class="w-full px-4 py-2 rounded border border-gray-300 focus:outline-none focus:ring-2 focus:ring-[#3085BC]" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700">Edad</label>
                    <input name="EdadUsuario" value="@Model.EdadUsuario" type="number"
                        class="w-full px-4 py-2 rounded border border-gray-300 focus:outline-none focus:ring-2 focus:ring-[#3085BC]" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700">Celular</label>
                    <input name="CelularUsuario" value="@Model.CelularUsuario" type="text"
                        class="w-full px-4 py-2 rounded border border-gray-300 focus:outline-none focus:ring-2 focus:ring-[#3085BC]" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700">Cédula</label>
                    <input name="CedulaUsuario" value="@Model.CedulaUsuario" type="text" readonly
                        class="w-full px-4 py-2 rounded bg-gray-100 text-gray-600 border border-gray-300" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700">Email</label>
                    <input name="EmailUsuario" value="@Model.EmailUsuario" type="email"
                        class="w-full px-4 py-2 rounded border border-gray-300 focus:outline-none focus:ring-2 focus:ring-[#3085BC]" />
                </div>

                <input type="hidden" name="IdRol" value="@Model.IdRol" />

                <div>
                    <label class="block text-sm font-medium text-gray-700">Cantidad de Facturas</label>
                    <input name="CantidadFacturas" value="@Model.CantidadFacturas" type="number" readonly
                        class="w-full px-4 py-2 rounded bg-gray-100 text-gray-600 border border-gray-300" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700">Contraseña</label>
                    <input name="Contrasena" value="@Model.Contrasena" type="password"
                        class="w-full px-4 py-2 rounded border border-gray-300 focus:outline-none focus:ring-2 focus:ring-[#3085BC]" />
                </div>
            </div>

            <div class="mt-8 flex justify-center">
                <button type="submit"
                    class="bg-[#3085BC] hover:bg-[#256D9D] text-white font-bold py-2 px-10 rounded shadow-lg transition duration-300">
                    Actualizar Usuario
                </button>
            </div>
        </div>
    </div>
</form>
