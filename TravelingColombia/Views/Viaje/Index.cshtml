@model TravelingColombia.ViewModels.ViajesGenericoViewModel

<div class="min-h-screen bg-gradient-to-b flex flex-col items-center p-6 space-y-6">

    <!-- Botones superiores -->
    <div
        class="flex w-full justify-between items-center bg-[#3085BC] rounded-xl shadow-lg p-4 px-16 flex-nowrap overflow-x-auto gap-2">
        <button id="btn-Lista" onclick="mostrarApartado('Lista')" class="text-black cursor-pointer bg-[#6ca7cf] px-2 py-1 rounded-full 
               text-sm sm:text-base md:text-lg w-24 sm:w-28 md:w-32 lg:w-40 h-10 sm:h-12 md:h-14">
            Lista
        </button>
        <button id="btn-Crear" onclick="mostrarApartado('Crear')" class="text-black cursor-pointer bg-white font-semibold px-2 py-1 rounded-full 
               text-sm sm:text-base md:text-lg w-24 sm:w-28 md:w-32 lg:w-40 h-10 sm:h-12 md:h-14">
            Crear
        </button>
    </div>

    <!-- Contenedor de Lista de viajes -->
    <div id="Lista" class="w-full max-w-[1500px] rounded-2xl p-8">

        <div
            class="relative p-10 rounded-xl bg-[url('https://img.freepik.com/foto-gratis/terminal-aeropuerto_1417-1456.jpg?semt=ais_hybrid&w=740')] bg-cover">
            <h2
                class="relative bottom-18 text-2xl w-[900px] h-[60px] rounded-full border left-60 bg-white font-bold text-center pt-2">
                Gestión de Viajes
            </h2>

            <!-- Formulario de búsqueda -->
            <form asp-action="Index" asp-controller="Viaje" method="post"
                class="flex flex-wrap gap-x-10 gap-y-5 w-full p-6 bg-white rounded-xl shadow-lg">

                <!-- Nombre Aerolínea o Destino (si aplica en el modelo) -->
                <div class="flex flex-col flex-1 min-w-[200px]">
                    <label class="mb-1 font-semibold text-gray-700">Nombre</label>
                    <input type="text" name="Nombre" placeholder="Ingrese nombre"
                        class="p-2 rounded-lg border border-gray-300" />
                </div>

                <!-- Destino Ida -->
                <div class="flex flex-col flex-1 min-w-[200px]">
                    <label class="mb-1 font-semibold text-gray-700">Destino Ida</label>
                    <select name="IdDestinoIda" class="p-2 rounded-lg border border-gray-300">
                        <option value="">Seleccione Destino Ida</option>
                        @foreach (var item in Model.ListadoDestino)
                        {
                            <option value="@item.IdDestino">@item.NombreDestino</option>
                        }
                    </select>
                </div>

                <!-- Destino Llegada -->
                <div class="flex flex-col flex-1 min-w-[200px]">
                    <label class="mb-1 font-semibold text-gray-700">Destino Llegada</label>
                    <select name="IdDestinoLlegada" class="p-2 rounded-lg border border-gray-300">
                        <option value="">Seleccione Destino Llegada</option>
                        @foreach (var item in Model.ListadoDestino)
                        {
                            <option value="@item.IdDestino">@item.NombreDestino</option>
                        }
                    </select>
                </div>

                <!-- Aerolínea -->
                <div class="flex flex-col flex-1 min-w-[200px]">
                    <label class="mb-1 font-semibold text-gray-700">Aerolínea</label>
                    <select name="IdAerolinea" class="p-2 rounded-lg border border-gray-300">
                        <option value="">Seleccione Aerolínea</option>
                        @foreach (var item in Model.ListadoAerolinea)
                        {
                            <option value="@item.IdAerolinea">@item.NombreAerolinea</option>
                        }
                    </select>
                </div>

                <!-- Fecha mínima -->
                <div class="flex flex-col flex-1 min-w-[200px]">
                    <label class="mb-1 font-semibold text-gray-700">Fecha Mínima</label>
                    <input type="date" name="FechaMinima" class="p-2 rounded-lg border border-gray-300" />
                </div>

                <!-- Fecha máxima -->
                <div class="flex flex-col flex-1 min-w-[200px]">
                    <label class="mb-1 font-semibold text-gray-700">Fecha Máxima</label>
                    <input type="date" name="FechaMaxima" class="p-2 rounded-lg border border-gray-300" />
                </div>

                <!-- Precio mínimo -->
                <div class="flex flex-col flex-1 min-w-[200px]">
                    <label class="mb-1 font-semibold text-gray-700">Precio Mínimo</label>
                    <input type="number" name="PrecioMinimo" class="p-2 rounded-lg border border-gray-300"
                        placeholder="Ingrese precio mínimo" />
                </div>

                <!-- Precio máximo -->
                <div class="flex flex-col flex-1 min-w-[200px]">
                    <label class="mb-1 font-semibold text-gray-700">Precio Máximo</label>
                    <input type="number" name="PrecioMaximo" class="p-2 rounded-lg border border-gray-300"
                        placeholder="Ingrese precio máximo" />
                </div>

                <!-- Botón buscar -->
                <div class="flex justify-center w-full mt-4">
                    <button type="submit"
                        class="bg-[#3085BC] hover:bg-[#3084bcd2] cursor-pointer text-white font-bold py-3 px-8 rounded-full transition duration-300">
                        Buscar
                    </button>
                </div>
            </form>

            <!-- Tabla de viajes -->
            <div
                class="bg-white w-full max-w-full h-[400px] p-4 mt-6 overflow-x-auto overflow-y-auto rounded-xl shadow-md">
                <table class="min-w-[700px] w-full border-collapse table-auto">
                    <thead>
                        <tr class="bg-[#3085BC] text-white text-sm sm:text-base">
                            <th class="px-4 py-2 border">Id Viaje</th>
                            <th class="px-4 py-2 border">Imagen</th>
                            <th class="px-4 py-2 border">Destino Ida</th>
                            <th class="px-4 py-2 border">Destino Llegada</th>
                            <th class="px-4 py-2 border">H. Salida</th>
                            <th class="px-4 py-2 border">H. Llegada</th>
                            <th class="px-4 py-2 border">Fecha Viaje</th>
                            <th class="px-4 py-2 border">Precio</th>
                            <th class="px-4 py-2 border">Cantidad Puestos</th>
                            <th class="px-4 py-2 border">Aerolínea</th>
                            <th class="px-4 py-2 border">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.ListadoViajes)
                        {
                            <tr class="text-sm sm:text-base hover:bg-[#3085BC]/30 transition">
                                <td class="px-4 py-2 border">@item.IdViaje</td>
                                <td class="px-4 py-2 border">
                                    <img src="@item.Imagen">
                                </td>
                                <td class="px-4 py-2 border">@item.DestinoIda</td>
                                <td class="px-4 py-2 border">@item.DestinoLlegada</td>
                                <td class="px-4 py-2 border">@item.HoraSalida</td>
                                <td class="px-4 py-2 border">@item.HoraLlegada</td>
                                <td class="px-4 py-2 border">@item.FechaViaje</td>
                                <td class="px-4 py-2 border">$@item.PrecioViaje</td>
                                <td class="px-4 py-2 border">@item.CantidadPuestos</td>
                                <td class="px-4 py-2 border">@item.AerolineaNombre</td>
                                <td class="h-auto w-auto gap-2 px-4 py-2 border">
                                    <a asp-action="Editar" asp-route-id="@item.IdViaje"
                                        class="btn btn-sm btn-warning">Editar</a>
                                    <form asp-action="Delete" asp-route-id="@item.IdViaje" asp-controller="Viaje"
                                        method="post" onsubmit="return confirm('¿Estás seguro de eliminar este viaje?');"
                                        class="inline">
                                        <button type="submit" class="btn btn-sm btn-error">Eliminar</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>

    <div id="Crear" class="max-w-2xl mx-auto bg-white shadow-lg rounded-xl p-8 hidden" >
        <h1 class="text-2xl font-bold mb-6 text-center">Formulario de Viajes</h1>
        <form asp-action="Create" asp-controller="Viaje" class="space-y-4" method="post" enctype="multipart/form-data">

            <select name="IdDestinoIda" class="p-2 rounded-lg border border-gray-300">
                <option value="">Seleccione Destino Ida</option>
                @foreach (var item in Model.ListadoDestino)
                {
                    <option value="@item.IdDestino">@item.NombreDestino</option>
                }
            </select>

            <select name="IdDestinoLlegada" class="p-2 rounded-lg border border-gray-300">
                <option value="">Seleccione Destino Llegada</option>
                @foreach (var item in Model.ListadoDestino)
                {
                    <option value="@item.IdDestino">@item.NombreDestino</option>
                }
            </select>

            <div class="flex flex-col flex-1 min-w-[200px]">
                <label class="mb-1 font-semibold text-gray-700">Hora Salida</label>
                <input name="HoraSalida" type="time" class="p-2 rounded-lg border border-gray-300" />
            </div>

            <div class="flex flex-col flex-1 min-w-[200px]">
                <label class="mb-1 font-semibold text-gray-700">Hora Llegada</label>
                <input name="HoraLlegada" type="time" class="p-2 rounded-lg border border-gray-300" />
            </div>

            <div class="flex flex-col flex-1 min-w-[200px]">
                <label class="mb-1 font-semibold text-gray-700">Fecha</label>
                <input name="FechaViaje" type="date" class="p-2 rounded-lg border border-gray-300" />
            </div>

            <div class="flex flex-col flex-1 min-w-[200px]">
                <label class="mb-1 font-semibold text-gray-700">Precio</label>
                <input name="PrecioViaje" type="number" placeholder="Precio"
                    class="p-2 rounded-lg border border-gray-300" />
            </div>
            <div>
                <label name="CantidadPuestos" class="block text-gray-700 font-semibold mb-1">Cantidad de Puestos</label>
                <input name="CantidadPuestos" type="number"
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400"
                    required />
            </div>
            <div class="flex flex-col flex-1 min-w-[200px]">
                <label class="mb-1 font-semibold text-gray-700">Aerolinea</label>
                <select name="IdAerolinea" class="p-2 rounded-lg border border-gray-300">
                    <option value="">Seleccione Aerolinea</option>
                    @foreach (var item in Model.ListadoAerolinea)
                    {
                        <option value="@item.IdAerolinea">@item.NombreAerolinea</option>
                    }
                </select>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700">Imagen</label>
                <input type="file" name="ImagenArchivo" accept="image/*"
                    class="mt-1 block w-full text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" />
            </div>
            <div class="pt-4">
                <button type="submit" class="w-full bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700">
                    Guardar Viaje
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function mostrarApartado(id) {
            // Oculta ambos apartados
            document.getElementById('Lista').classList.add('hidden');
            document.getElementById('Crear').classList.add('hidden');

            // Quita clases activas de botones
            document.getElementById('btn-Lista').classList.remove('bg-[#6ca7cf]', 'text-white');
            document.getElementById('btn-Crear').classList.remove('bg-[#6ca7cf]', 'text-white');

            // Restaura clases inactivas
            document.getElementById('btn-Lista').classList.add('bg-white', 'text-black');
            document.getElementById('btn-Crear').classList.add('bg-white', 'text-black');

            // Activa botón y muestra sección correspondiente
            document.getElementById(`btn-${id}`).classList.remove('bg-white', 'text-black');
            document.getElementById(`btn-${id}`).classList.add('bg-[#6ca7cf]', 'text-white');
            document.getElementById(id).classList.remove('hidden');
        }
    </script>
}

}
