@model TravelingColombia.ViewModels.ViajesViewModel

<div id="Editar" class="max-w-2xl mx-auto bg-white shadow-lg rounded-xl p-8">
    <h1 class="text-2xl font-bold mb-6 text-center">Editar Viaje</h1>
    <form asp-action="Editar" method="post" class="space-y-4">
        <input type="hidden" asp-for="Viaje.IdViaje" />

        <!-- Destino Ida -->
        <div class="flex flex-col flex-1 min-w-[200px]">
            <label class="mb-1 font-semibold text-gray-700">Destino Ida</label>
            <select asp-for="Viaje.IdDestinoIda" class="p-2 rounded-lg border border-gray-300">
                <option value="">Seleccione Destino Ida</option>
                @foreach (var destino in Model.ListadoDestinos)
                {
                    <option value="@destino.IdDestino" selected="@(destino.IdDestino == Model.Viaje.IdDestinoIda)">
                        @destino.NombreDestino
                    </option>
                }
            </select>
        </div>

        <!-- Destino Llegada -->
        <div class="flex flex-col flex-1 min-w-[200px]">
            <label class="mb-1 font-semibold text-gray-700">Destino Llegada</label>
            <select asp-for="Viaje.IdDestinoLlegada" class="p-2 rounded-lg border border-gray-300">
                <option value="">Seleccione Destino Llegada</option>
                @foreach (var destino in Model.ListadoDestinos)
                {
                    <option value="@destino.IdDestino" selected="@(destino.IdDestino == Model.Viaje.IdDestinoLlegada)">
                        @destino.NombreDestino
                    </option>
                }
            </select>
        </div>

        <!-- Hora de Salida -->
        <div>
            <label class="block text-sm font-medium text-gray-700">Hora de Salida</label>
            <input type="time" asp-for="Viaje.HoraSalida" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm" />
        </div>

        <!-- Hora de Llegada -->
        <div>
            <label class="block text-sm font-medium text-gray-700">Hora de Llegada</label>
            <input type="time" asp-for="Viaje.HoraLlegada" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm" />
        </div>

        <!-- Fecha del Viaje -->
        <div>
            <label class="block text-sm font-medium text-gray-700">Fecha del Viaje</label>
            <input type="date" asp-for="Viaje.FechaViaje" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm" />
        </div>

        <!-- Precio del Viaje -->
        <div>
            <label class="block text-sm font-medium text-gray-700">Precio del Viaje</label>
            <input type="number" asp-for="Viaje.PrecioViaje" step="0.01" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm" />
        </div>

        <!-- Cantidad de Puestos -->
        <div>
            <label class="block text-sm font-medium text-gray-700">Cantidad de Puestos</label>
            <input type="number" asp-for="Viaje.CantidadPuestos" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm" />
        </div>

        <!-- Aerolínea -->
        <div class="flex flex-col flex-1 min-w-[200px]">
            <label class="mb-1 font-semibold text-gray-700">Aerolínea</label>
            <select asp-for="Viaje.IdAerolinea" class="p-2 rounded-lg border border-gray-300">
                <option value="">Seleccione Aerolínea</option>
                @foreach (var aerolinea in Model.ListadoAerolineas)
                {
                    <option value="@aerolinea.IdAerolinea" selected="@(aerolinea.IdAerolinea == Model.Viaje.IdAerolinea)">
                        @aerolinea.NombreAerolinea
                    </option>
                }
            </select>
        </div>

        <!-- Imagen -->
        <div>
            <label class="block text-sm font-medium text-gray-700">Imagen</label>
            <input type="file" asp-for="Viaje.Imagen" accept="image/*" class="mt-1 block w-full text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" />
        </div>

        <!-- Botón -->
        <div class="pt-4">
            <button type="submit"
                    class="w-full bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700">
                Guardar Cambios
            </button>
        </div>
    </form>
</div>
