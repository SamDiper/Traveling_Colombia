@model TravelingColombia.Filtros.FiltroViajesViewModel

<div id="Editar" class="max-w-3xl mx-auto mt-10 bg-white p-8 rounded-lg shadow-lg">
    <h2 class="text-2xl font-bold mb-6 text-center text-blue-600">Editar Viaje</h2>

    <form method="post" asp-action="Editar" asp-controller="Viaje" class="grid grid-cols-1 md:grid-cols-2 gap-6" enctype="multipart/form-data">
        
        <!-- ID Viaje (oculto) -->
        <input type="hidden" asp-for="IdViaje" />

        <!-- Destino Ida -->
        <div>
            <label asp-for="IdDestinoIda" class="block text-gray-700 font-semibold mb-1">Destino de Ida</label>
            <select asp-for="IdDestinoIda" asp-items="ViewBag.ListadoDestinos"
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400" required>
                <option value="">Seleccione destino de ida</option>
            </select>
        </div>

        <!-- Destino Llegada -->
        <div>
            <label asp-for="IdDestinoLlegada" class="block text-gray-700 font-semibold mb-1">Destino de Llegada</label>
            <select asp-for="IdDestinoLlegada" asp-items="ViewBag.ListadoDestinos"
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400" required>
                <option value="">Seleccione destino de llegada</option>
            </select>
        </div>

        <!-- Hora de Salida -->
        <div>
            <label asp-for="HoraSalida" class="block text-gray-700 font-semibold mb-1">Hora de Salida</label>
            <input asp-for="HoraSalida" type="time" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400" required />
        </div>

        <!-- Hora de Llegada -->
        <div>
            <label asp-for="HoraLlegada" class="block text-gray-700 font-semibold mb-1">Hora de Llegada</label>
            <input asp-for="HoraLlegada" type="time" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400" required />
        </div>

        <!-- Fecha del Viaje -->
        <div>
            <label asp-for="FechaViaje" class="block text-gray-700 font-semibold mb-1">Fecha del Viaje</label>
            <input asp-for="FechaViaje" type="date" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400" required />
        </div>

        <!-- Precio del Viaje -->
        <div>
            <label asp-for="PrecioViaje" class="block text-gray-700 font-semibold mb-1">Precio del Viaje</label>
            <input asp-for="PrecioViaje" type="number" step="0.01" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400" required />
        </div>

        <!-- Cantidad de Puestos -->
        <div>
            <label asp-for="CantidadPuestos" class="block text-gray-700 font-semibold mb-1">Cantidad de Puestos</label>
            <input asp-for="CantidadPuestos" type="number" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400" required />
        </div>

        <!-- Aerolínea -->
        <div>
            <label asp-for="IdAerolinea" class="block text-gray-700 font-semibold mb-1">Aerolínea</label>
            <select asp-for="IdAerolinea" asp-items="ViewBag.ListadoAerolineas"
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400" required>
                <option value="">Seleccione una aerolínea</option>
            </select>
        </div>
        @if (!string.IsNullOrEmpty(Model.Imagen))
        {
            <div class="md:col-span-2 mb-4">
                <label class="block text-sm font-medium text-gray-700">Imagen Actual</label>
                <img src="@Model.Imagen" alt="Imagen viaje" class="w-48 h-auto rounded-md" />
            </div>
        }
        <!-- Imagen (URL o nombre del archivo) -->
        <div>
            <label class="block text-sm font-medium text-gray-700">Imagen</label>
            <input asp-for="ImagenArchivo" type="file" name="ImagenArchivo" accept="image/*"
                class="mt-1 block w-full text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" />
        </div>

        <!-- Botón de Guardar -->
        <div class="md:col-span-2 flex justify-center">
            <button type="submit" class="bg-blue-600 text-white font-bold py-2 px-6 rounded-lg hover:bg-blue-700 transition duration-300">
                Guardar Cambios
            </button>
        </div>
    </form>
</div>
